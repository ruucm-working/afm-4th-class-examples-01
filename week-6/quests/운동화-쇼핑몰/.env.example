# Supabase → Project Settings → Database → Connection string (Transaction pooler, 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 토스페이먼츠 → 개발자센터 → API 키 (결제위젯 연동 키)
# 클라이언트 키는 공개되어도 되는 값 → /api/config 로 브라우저에 내려준다
TOSS_CLIENT_KEY=
# 시크릿 키는 절대 브라우저로 내려보내지 않는다. 결제 승인은 서버만 할 수 있다
TOSS_SECRET_KEY=

# JWT 서명 비밀키 — 아래 명령으로 만든 긴 무작위 문자열을 넣는다
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ImageKit — 관리자 페이지에서 썸네일을 올릴 때 쓴다 (Vercel 에도 넣는다).
# 서버는 비공개 키로 1회용 업로드 서명만 만들어 주고, 파일은 브라우저가 ImageKit 에 직접 올린다.
# 비공개 키는 브라우저로 나가지 않는다.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<imagekit-id>
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

PORT=6070
