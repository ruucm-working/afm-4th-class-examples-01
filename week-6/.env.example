# Supabase → Project Settings → Database → Connection string (Transaction pooler, 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 토스페이먼츠 → 개발자센터 → API 키
# 클라이언트 키는 공개되어도 되는 값 → /api/config 로 브라우저에 내려준다
TOSS_CLIENT_KEY=
# 시크릿 키는 절대 브라우저로 내려보내지 않는다. 결제 승인은 서버만 할 수 있다
TOSS_SECRET_KEY=

# JWT 서명 비밀키 — 아래 명령으로 만든 긴 무작위 문자열을 넣는다
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

PORT=6060
